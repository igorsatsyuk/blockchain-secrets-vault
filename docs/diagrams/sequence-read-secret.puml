@startuml
title Sequence: Read Secret (ACL check -> decrypt -> audit)

actor Client
participant "Secrets UI\n(Angular)" as UI
participant "Secrets API\n:8080" as API
participant "SecretsAcl\nContract" as Contract
participant "KMS Service" as KMS
database "Encrypted Store\n(PostgreSQL/Redis)" as Store
participant "Audit Writer" as Audit

Client -> UI: Open secret
UI -> API: GET /secrets/{id}\nAuthorization: Bearer <JWT>

API -> Contract: canRead(secretId, caller)
Contract --> API: true

API -> Store: Load encrypted payload
Store --> API: ciphertext + metadata

API -> KMS: decrypt(ciphertext)
KMS --> API: plaintext secret

API -> Audit: emit READ event
Audit -> Contract: auditEvent(secretId, caller, READ, hash)
Contract --> Audit: tx receipt

API --> UI: 200 { secret }
UI --> Client: Show secret

@enduml
