{
  "name": "blockchain-secrets-vault-contracts",
  "version": "0.1.0",
  "description": "Solidity contracts for Blockchain Secrets Vault (on-chain ACL and audit)",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
